{
  appId: 'com.personalvault.app',
  productName: 'Personal Vault',
  directories: {
    output: 'dist',
    buildResources: 'build'
  },
  files: ['out/**/*', 'THIRD_PARTY_NOTICES.md'],
  asarUnpack: [
    'node_modules/sharp/**/*',
    'node_modules/@img/**/*',
    'node_modules/onnxruntime-node/bin/napi-v6/win32/x64/**/*'
  ],
  win: {
    target: [
      {
        target: 'dir',
        arch: ['x64']
      }
    ]
  }
}
