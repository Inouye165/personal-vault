{
  "name": "personal-vault",
  "version": "0.1.0",
  "description": "Personal Vault - Photo and Document Catalog & Vault Desktop Application",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Personal Vault Contributors",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:installer": "npm run verify:vcredist && npm run build && electron-builder --win",
    "fetch:vcredist": "node scripts/fetch-vcredist-x64.mjs",
    "verify:vcredist": "node scripts/fetch-vcredist-x64.mjs --verify-only",
    "smoke:dev": "node scripts/smoke.mjs --mode=dev",
    "smoke:built": "node scripts/smoke.mjs --mode=built",
    "smoke:unpacked": "node scripts/smoke.mjs --mode=unpacked",
    "verify:sqlite": "node scripts/verify-electron-sqlite.mjs",
    "verify:sqlite:unpacked": "node scripts/verify-electron-sqlite.mjs --mode=unpacked",
    "verify:scan": "node scripts/verify-electron-scan.mjs",
    "verify:scan:unpacked": "node scripts/verify-electron-scan.mjs --mode=unpacked",
    "verify:duplicates": "node scripts/verify-electron-duplicate-review.mjs",
    "verify:duplicates:unpacked": "node scripts/verify-electron-duplicate-review.mjs --mode=unpacked",
    "verify:vault": "node scripts/verify-electron-vault-import.mjs",
    "verify:vault:unpacked": "node scripts/verify-electron-vault-import.mjs --mode=unpacked",
    "verify:photos": "node scripts/verify-electron-photos.mjs",
    "verify:photos:unpacked": "node scripts/verify-electron-photos.mjs --mode=unpacked",
    "verify:photo-review": "node scripts/verify-electron-photo-review.mjs",
    "verify:photo-review:unpacked": "node scripts/verify-electron-photo-review.mjs --mode=unpacked",
    "verify:similarity": "node scripts/verify-electron-similarity.mjs",
    "verify:similarity:unpacked": "node scripts/verify-electron-similarity.mjs --mode=unpacked",
    "verify:semantic-index": "node scripts/verify-electron-semantic-index.mjs",
    "verify:semantic-index:unpacked": "node scripts/verify-electron-semantic-index.mjs --mode=unpacked",
    "verify:semantic-search": "node scripts/verify-electron-semantic-search.mjs",
    "verify:semantic-search:unpacked": "node scripts/verify-electron-semantic-search.mjs --mode=unpacked",
    "verify:metadata": "node scripts/verify-electron-metadata.mjs",
    "verify:metadata:unpacked": "node scripts/verify-electron-metadata.mjs --mode=unpacked",
    "verify:documents": "node scripts/verify-electron-documents.mjs",
    "verify:documents:unpacked": "node scripts/verify-electron-documents.mjs --mode=unpacked",
    "verify:ocr-foundation": "node scripts/verify-electron-ocr-foundation.mjs",
    "verify:ocr-foundation:unpacked": "node scripts/verify-electron-ocr-foundation.mjs --mode=unpacked",
    "verify:ocr-persistence": "node scripts/verify-electron-ocr-persistence.mjs",
    "verify:ocr-persistence:unpacked": "node scripts/verify-electron-ocr-persistence.mjs --mode=unpacked",
    "verify:ocr-ui": "node scripts/verify-electron-ocr-ui.mjs",
    "verify:ocr-ui:unpacked": "node scripts/verify-electron-ocr-ui.mjs --mode=unpacked",
    "verify:doc-semantic-foundation": "node scripts/verify-electron-doc-semantic-foundation.mjs",
    "verify:doc-semantic-foundation:unpacked": "node scripts/verify-electron-doc-semantic-foundation.mjs --mode=unpacked",
    "verify:doc-semantic-persistence": "node scripts/verify-electron-doc-semantic-persistence.mjs",
    "verify:doc-semantic-persistence:unpacked": "node scripts/verify-electron-doc-semantic-persistence.mjs --mode=unpacked",
    "verify:doc-semantic-search": "node scripts/verify-electron-doc-semantic-search.mjs",
    "verify:doc-semantic-search:unpacked": "node scripts/verify-electron-doc-semantic-search.mjs --mode=unpacked",
    "verify:doc-classify-foundation": "node scripts/verify-electron-doc-classify-foundation.mjs",
    "verify:doc-classify-foundation:unpacked": "node scripts/verify-electron-doc-classify-foundation.mjs --mode=unpacked",
    "verify:doc-classify-persistence": "node scripts/verify-electron-doc-classify-persistence.mjs",
    "verify:doc-classify-persistence:unpacked": "node scripts/verify-electron-doc-classify-persistence.mjs --mode=unpacked",
    "verify:doc-classify-ui": "node scripts/verify-electron-doc-classify-ui.mjs",
    "verify:doc-classify-ui:unpacked": "node scripts/verify-electron-doc-classify-ui.mjs --mode=unpacked",
    "verify:unified-search": "node scripts/verify-electron-unified-search.mjs",
    "verify:unified-search:unpacked": "node scripts/verify-electron-unified-search.mjs --mode=unpacked",
    "verify:backup": "node scripts/verify-electron-backup-restore.mjs --mode=built",
    "verify:backup:unpacked": "node scripts/verify-electron-backup-restore.mjs --mode=unpacked",
    "verify:recovery": "node scripts/verify-electron-catalog-recovery.mjs --mode=built",
    "verify:recovery:unpacked": "node scripts/verify-electron-catalog-recovery.mjs --mode=unpacked",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@napi-rs/canvas": "1.1.1",
    "exifreader": "4.54.0",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "libheif-js": "1.23.5",
    "lucide-react": "^1.16.0",
    "onnxruntime-node": "1.31.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tesseract.js-core": "7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
