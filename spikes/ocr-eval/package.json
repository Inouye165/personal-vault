{
  "name": "personal-vault-ocr-eval-spike",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Personal Vault Contributors",
  "description": "Isolated Stage 7C feasibility spike for offline OCR and scanned-PDF rasterization",
  "scripts": {
    "fetch-model": "node fetch-ocr-model.mjs",
