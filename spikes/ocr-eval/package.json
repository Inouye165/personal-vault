    "verify:unpacked": "node run-electron-ocr-spike.mjs --mode=unpacked"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.1",
    "pdfjs-dist": "6.5.438",
    "sharp": "0.35.5",
    "tesseract.js-core": "7.0.0"
  }
}
